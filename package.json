{
  "name": "novel-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --conditions=react-server --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "env:check": "node --import tsx scripts/check-env.ts",
    "db:verify": "node --import tsx --conditions=react-server scripts/verify-database.ts",
    "blob:verify": "node --import tsx scripts/verify-blob.ts"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/blob": "2.8.2",
    "iron-session": "9.0.1",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
