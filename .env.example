# Server only. Set real values in .env.local / Vercel, never commit them.
DATABASE_URL=postgresql://APP_ROLE.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
DATABASE_SCHEMA=novel_preview
ADMIN_PASSWORD_HASH=scrypt:SALT_HEX:HASH_HEX
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RATE_LIMIT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BLOB_READ_WRITE_TOKEN=REPLACE_WITH_VERCEL_BLOB_TOKEN
# Public project configuration; never use service_role or Google Client Secret here.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_KEY
